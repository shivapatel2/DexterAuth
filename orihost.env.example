# Orihost / Pterodactyl — set these in the panel's Startup tab
GIT_ADDRESS=https://github.com/shivapatel2/DexterAuth.git
BRANCH=main
USERNAME=shivapatel2
ACCESS_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # GitHub PAT (classic) with repo read
AUTO_UPDATE=1
MAIN_FILE=dist/index.js
# Actually use root package.json start: set MAIN_FILE to index.js? Orihost runs `node /home/container/${MAIN_FILE}`
# With root package.json postinstall, the bot will be built at Discord-Bot/dist/index.js
# So set MAIN_FILE=Discord-Bot/dist/index.js  OR  set to index.js and ensure root start handles it
# Recommended:
# MAIN_FILE=Discord-Bot/dist/index.js
